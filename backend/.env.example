# ─────────────────────────────────────────────
# Ankelba Backend — Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ankelba_dev
DB_USER=postgres
DB_PASSWORD=your_password_here

# DB_* above is for migrations only. Generate two independent random passwords,
# run npm run migrate, then npm run db:runtime:setup before starting the server.
APP_DB_USER=ankelba_tenant_app
APP_DB_PASSWORD=
CONTROL_DB_USER=ankelba_control_app
CONTROL_DB_PASSWORD=

# JWT Authentication (NFR-SEC-07, FR-UAM-07)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=24h

# Opt-in backend preview only. Leave false until the coordinated client cutover.
# Requires migrations through 017; enable only in development/test databases.
# Production activation is blocked until client cutover and isolation are complete.
DAYCARE_AUTH_ENABLED=false
DAYCARE_SESSION_TTL_SECONDS=28800
DAYCARE_AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000,http://127.0.0.1:3000
# Required only when preview is enabled. Supply a private JSON keyring, with
# each value a base64-encoded 32-byte random key; no built-in key is provided.
# Keep old keys available when rotating, so existing MFA secrets can decrypt.
AUTH_ENCRYPTION_KEYS={}
AUTH_ENCRYPTION_ACTIVE_KEY_ID=
# Must be one exact allowed origin; recovery tokens go in the URL fragment.
AUTH_RESET_BASE_URL=http://localhost:8081
# Recovery emails stay in the encrypted local database outbox; no SMTP is used.
# Inspect metadata: npm run auth:inbox -- list
# Explicitly reveal one message: npm run auth:inbox -- view <message-uuid>

# AI Parent Guide (TBD-03 — placeholder until advisor confirms provider)
AI_API_KEY=placeholder_replace_when_provider_confirmed
AI_API_BASE_URL=https://api.example.com/v1
NVIDIA_API_KEY=placeholder_replace_when_provider_confirmed
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional second, independently verified chat model. Leave blank to use prepared fallback.
NVIDIA_FALLBACK_MODEL=

# Chapa Payment Gateway (TBD-02 — sandbox key for development)
CHAPA_SECRET_KEY=placeholder_replace_with_chapa_sandbox_key
CHAPA_WEBHOOK_SECRET=placeholder_replace_with_chapa_webhook_secret
# Payment simulation is opt-in and works only with NODE_ENV=development.
ENABLE_DEMO_PAYMENTS=false

# Subscription renewal email reminders (disabled until SMTP is configured).
SUBSCRIPTION_REMINDERS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:8081

# Platform subscriptions: configure the receiving account and a Veritas key.
# Without these values, subscription checkout is unavailable or pending review.
SUBSCRIPTION_RECEIVING_ACCOUNT=
# Optional bootstrap fallback when payment settings have not been configured in the operator console.
SUBSCRIPTION_RECEIVING_INSTITUTION=
SUBSCRIPTION_RECEIVING_NAME=
VERITAS_API_KEY=
VERITAS_API_URL=https://verifyapi.leulzenebe.pro
# Temporary local testing only. Ignored unless NODE_ENV=development.
# Keep false for normal amount/currency/name/account/reference/date matching.
SUBSCRIPTION_NAME_AMOUNT_TEST_MODE=false
# Receipt OCR runs locally and requires Tesseract with English trained data.
# Set an absolute executable path if `tesseract` is not on PATH.
SUBSCRIPTION_OCR_COMMAND=tesseract

# Plus scheduled billing. Email additionally requires SMTP and each parent opt-in.
BILLING_AUTOMATION_ENABLED=false
BILLING_AUTOMATION_EMAIL_ENABLED=false
